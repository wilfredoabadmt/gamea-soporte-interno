# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA DE GESTIÓN Y SOPORTE INTERNO — GAMEA
# ==============================================================================

# Puerto de escucha del servidor HTTP
PORT=3000

# Clave de API de OpenRouter para el Agente Inteligente Institucional
# Obtén tu clave en: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modelo predeterminado de OpenRouter (Modelos 100% GRATUITOS)
# Ejemplos: google/gemini-2.0-flash-exp:free, meta-llama/llama-3.3-70b-instruct:free, deepseek/deepseek-r1:free
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Entorno de ejecución (development | production)
NODE_ENV=production
