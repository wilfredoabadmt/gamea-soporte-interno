# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA DE GESTIÓN Y SOPORTE INTERNO — GAMEA
# ==============================================================================

# Puerto de escucha del servidor HTTP
PORT=3000

# Clave de API de OpenRouter para el Agente Inteligente Institucional
# Obtén tu clave en: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modelo predeterminado de OpenRouter (ej. anthropic/claude-3.5-sonnet, openai/gpt-4o, google/gemini-2.0-flash-001)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Entorno de ejecución (development | production)
NODE_ENV=production
